  "name": "Linkedin Automation AI",
  "nodes": [
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an expert LinkedIn content creator.\n\nWrite a highly engaging LinkedIn post.\n\nFollow this EXACT structure.\n\n🚀 Hook\n\n(One short sentence.)\n\nBlank line\n\nExplain the topic in 2–3 short sentences.\n\nBlank line\n\n💡 Why it matters\n\n2 short sentences.\n\nBlank line\n\n✅ Key Benefits\n\n✅ Benefit 1\n\n✅ Benefit 2\n\n✅ Benefit 3\n\nBlank line\n\n📌 Key Takeaways\n\n✔ Takeaway 1\n\n✔ Takeaway 2\n\n✔ Takeaway 3\n\nBlank line\n\n❓Ask one engaging question.\n\nBlank line\n\n👇 Share your thoughts!\n\nBlank line\n\nAdd 8–10 relevant hashtags.\n\nRules:\n- Maximum 220 words.\n- Every paragraph should be 1–2 lines only.\n- Leave one blank line between every section.\n- No HTML.\n- No Markdown.\n- Output only the LinkedIn post.",
        "options": {
          "systemMessage": "You are a professional LinkedIn content writer.\n\nWrite an engaging LinkedIn post.\n\nRequirements:\n- Output ONLY plain text.\n- Never output the characters \\n or \\\\n.\n- Never output HTML.\n- Never output Markdown.\n- Never output JSON.\n- Use real blank lines by pressing Enter.\n- Keep paragraphs short.\n- Use emojis naturally.\n- End with a question.\n- Add 8-10 relevant hashtags.\n\nThe response should be directly ready to paste into LinkedIn."
        }
      },
