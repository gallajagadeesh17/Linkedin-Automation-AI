    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional LinkedIn content writer.\n\nOriginal Post:\n{{ $('Code in JavaScript').item.json.original }}\n\nUser Feedback:\n{{ $('Send message and wait for response').item.json.data[\"Edit post\"] }}\n\nInstructions:\n- If the feedback is empty, generate a completely new LinkedIn post on the same topic.\n- If feedback is provided, rewrite the original post according to the user's instructions.\n- Keep the post professional and engaging.\n- Return only the final LinkedIn post.",
        "options": {
          "systemMessage": "=You are an expert LinkedIn content writer.\n\nYour task is to improve or regenerate a LinkedIn post.\n\nOriginal LinkedIn Post:\n{{ $('Code in JavaScript').item.json.original }}\n\nUser Feedback:\n{{ $('Send message and wait for response').item.json.data[\"Edit post\"] }}\n\nInstructions:\n- If the \"Edit post\" field is empty, generate a completely new LinkedIn post on the same topic.\n- If the user has provided feedback, rewrite the original post according to the user's instructions.\n- Make the content professional.\n- Keep paragraphs short.\n- Use emojis naturally.\n- Add 8–10 relevant hashtags.\n- End with an engaging question.\n\nReturn ONLY the LinkedIn post."
        }
      },
