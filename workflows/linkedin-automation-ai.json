      "parameters": {
        "jsCode": "const post = $input.first().json.output;\n\nconsole.log(post);\nconsole.log(JSON.stringify(post));\n\nreturn [{\n  json: {\n    original: post,\n    containsLiteral: post.includes(\"\\\\n\"),\n    containsRealNewline: post.includes(\"\\n\"),\n    charCodes: [...post.slice(0, 50)].map(c => c.charCodeAt(0))\n  }\n}];"
